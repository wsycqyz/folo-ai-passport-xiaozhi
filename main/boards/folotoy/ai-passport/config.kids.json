{
    "manufacturer": "folotoy",
    "type": "ai-passport",
    "target": "esp32c3",
    "builds": [
        {
            "name": "ai-passport-kids",
            "sdkconfig_append": [
                "CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y",
                "CONFIG_PARTITION_TABLE_CUSTOM_FILENAME=\"partitions/v2/8m.csv\"",
                "CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y",
                "CONFIG_LV_USE_QRCODE=n",
                "CONFIG_USE_ESP_WAKE_WORD=n",
                "CONFIG_AI_PASSPORT_KIDS_UI=y"
            ]
        },
        {
            "name": "ai-passport-kids-release",
            "sdkconfig_append": [
                "CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y",
                "CONFIG_PARTITION_TABLE_CUSTOM_FILENAME=\"partitions/v2/8m.csv\"",
                "CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y",
                "CONFIG_LV_USE_QRCODE=n",
                "CONFIG_USE_ESP_WAKE_WORD=n",
                "CONFIG_AI_PASSPORT_KIDS_UI=y",
                "CONFIG_AI_PASSPORT_IDLE_DEEP_SLEEP=y"
            ]
        }
    ]
}
